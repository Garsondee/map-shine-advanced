# Local AI/editor tooling config
.continue/

# Keyhole torture fixture — regenerable via `node tools/make-torture-world.mjs`
assets/torture/

# TSL spike build output — regenerate with: npm run build:three-webgpu
src/vendor/three/.webgpu-entry.js

# Shader Lab run evidence (reports, frame PNGs, generated WGSL) and the
# content-keyed derived-mask cache. Both are reproducible by re-running a
# scenario; a run worth keeping gets its SCENARIO committed, not its output.
# See docs/planning/Shader-Lab-Proving-Ground.md §5.3.
tools/shader-lab/runs/
tools/shader-lab/cache/

# The live-verification harness (V4-Testament P-001/P-003, 2026-08-10).
# Never commit: the in-repo Foundry INSTALL (675MB of licensed software — the
# harness merely discovers it on disk at FoundryVTT/), the harness's persistent
# Chrome profiles (session cookies + the BC IndexedDB cache), packaged module
# builds, or perf-capture OUTPUTS. Capture SCRIPTS are the scenario and ARE
# committed; a capture worth keeping gets its numbers into docs/planning/ —
# the same rule as tools/shader-lab/runs/ above.
FoundryVTT/
module.zip
tests/playwright-artifacts/chrome-profile/
tests/playwright-artifacts/chrome-profile-usercheck/
tests/playwright-artifacts/test-results/
tests/playwright-artifacts/look/*.json
tests/playwright-artifacts/look/*.png

# Raw Chrome DevTools Performance-panel captures handed to tools/trace-analyze.mjs.
# Same rule as perf-capture outputs above: these are regenerable evidence, not
# source — a capture worth keeping gets its findings into docs/planning/, not
# the .json(.gz) itself committed. Files run 10s-100s of MB.
chrome-performance-traces/
