{
  "name": "map-shine-advanced",
  "version": "1.0.0",
  "description": "Foundry VTT module with Three.js WebGPU",
  "scripts": {
    "lint": "eslint src tools",
    "lint:fix": "eslint src tools --fix",
    "format": "prettier --write \"src/**/*.{js,mjs}\" \"tools/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,mjs}\" \"tools/**/*.mjs\"",
    "verify": "npm run lint && npm run format:check && npm run verify:structure && npm run test:tools",
    "make:torture": "node tools/make-torture-world.mjs",
    "build:tsl": "node scripts/build/build.js",
    "release": "node scripts/release/release.js",
    "release:test": "node scripts/release/release.js --version 0.1.4 --force",
    "perf:test": "playwright test",
    "perf:test:headed": "playwright test --headed",
    "perf:install-browsers": "playwright install",
    "chart:generate": "node scripts/tools/generate-calibration-chart.mjs",
    "preset:insight": "node scripts/tools/preset-insight.mjs",
    "audit:controls": "node scripts/tools/audit-control-wiring.mjs",
    "knip": "knip",
    "knip:files": "knip --include files",
    "build:three-webgpu": "node tools/build-three-webgpu.mjs",
    "verify:structure": "node tools/verify-structure.mjs",
    "ratchets:update": "node tools/verify-structure.mjs --update-ratchets",
    "test:tools": "node tools/run-tests.mjs"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "esbuild": "^0.24.0",
    "eslint": "8.57.1",
    "eslint-plugin-unicorn": "50.0.1",
    "knip": "^5.88.1",
    "pngjs": "^7.0.0",
    "prettier": "3.3.3"
  }
}